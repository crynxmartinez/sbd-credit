# Credit Tracker: local configuration reference. Copy values into .env.databases (git-ignored). Never commit real values.
#
# Direct (non-pooled) address of the shared Postgres server. Local work only ever uses it through scripts/with-dev-db.mjs,
# which pins it to a credit_dev schema, so the live `public` tables are never touched.
LIVE_DATABASE_URL_DIRECT=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Optional but preferred: a RESTRICTED login that can reach only credit_dev* and credit_test* schemas (no access to `public`).
# When present it is used instead of the live server's own login, so a local tool can never read live data.
# DEV_DATABASE_URL_DIRECT=postgres://DEV_USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Optional. Defaults to credit_dev. Must match credit_dev or credit_test_<name>.
# CREDIT_DEV_SCHEMA=credit_dev

# --- .env.local (git-ignored) ---
# SESSION_SECRET=<32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))">
# DEV_ADMIN_USERNAME=admin
# DEV_ADMIN_PASSWORD=<choose one; used only by npm run seed:admin>
# CREDIT_DEV_AUTOLOGIN=1   # development only: skip the sign-in screen
# Time zone the business keeps its books in. The server decides "today" in it, for overdue, aging and which month is closed.
# Default: America/Chicago
# BUSINESS_TIME_ZONE=America/Chicago

# How many proxies sit in front of the app (0 to 5, default 1). The sign-in rate limits use the address the nearest proxy
# saw, so this must match reality, and the proxy must set X-Forwarded-For. Production only; ignored locally.
# TRUSTED_PROXY_HOPS=1

# The address customers use. Invitation links to the customer portal are built from this, never from the request.
# Required in production (https). Optional locally.
# PUBLIC_BASE_URL=https://credit.example.com
