# Credit Tracker: local configuration reference. Copy values into .env.databases (git-ignored). Never commit real values.
#
# Direct (non-pooled) address of the shared Postgres server. Local work only ever uses it through scripts/with-dev-db.mjs,
# which pins it to a credit_dev schema, so the live `public` tables are never touched.
LIVE_DATABASE_URL_DIRECT=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Optional. Defaults to credit_dev. Must match credit_dev or credit_test_<name>.
# CREDIT_DEV_SCHEMA=credit_dev

# --- .env.local (git-ignored) ---
# SESSION_SECRET=<32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))">
# DEV_ADMIN_USERNAME=admin
# DEV_ADMIN_PASSWORD=<choose one; used only by npm run seed:admin>
# CREDIT_DEV_AUTOLOGIN=1   # development only: skip the sign-in screen
# Time zone the business keeps its books in (overdue and aging fall back to it). Default: America/Chicago
# BUSINESS_TIME_ZONE=America/Chicago
