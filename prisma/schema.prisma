// Credit Tracker — Prisma schema.
// Lives in its own Postgres schema (credit_dev while developing) on the shared database server.
// Money is integer cents. The balance is never stored: it is computed from LedgerEntry rows.
// String fields with app-level validation stand in for enums, matching the shipper app.
// Every timestamp is timestamptz: it carries its zone, so a restore or a differently configured session cannot shift it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A person who can sign in. Roles match the shipper app: EMPLOYEE | ADMIN | SUPERADMIN.
model AppUser {
  id             String    @id @default(cuid())
  username       String    @unique
  name           String
  role           String    @default("EMPLOYEE")
  passwordHash   String
  active         Boolean   @default(true)
  /// Bumping this signs the user out everywhere.
  sessionVersion Int       @default(1)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
}

model Customer {
  id                   String    @id @default(cuid())
  businessName         String
  contactName          String?
  phone                String?
  email                String?
  billingAddress       String?

  /// submitted | under_review | approved | denied | suspended
  status               String    @default("submitted")
  dateApplied          DateTime  @db.Date
  /// The day the customer entered their current status. The "waiting for a decision" clock runs from here.
  statusChangedOn      DateTime  @db.Date
  requestedLimitCents  Int?
  creditLimitCents     Int       @default(0)
  paymentTerms         String    @default("Net 30")
  creditStartDate      DateTime? @db.Date

  accountingAppName    String?
  accountingProjectUrl String?
  notes                String?

  /// Sent by the browser once per form. A retry of the same submission finds the first result instead of repeating it.
  requestKey           String?   @unique
  /// Optimistic-concurrency counter: an edit made from a stale copy is refused instead of overwriting.
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  ledger               LedgerEntry[]
  audit                AuditEvent[]
  portalUsers          CustomerUser[]

  @@index([businessName])
}

/// A person at a customer who may sign in to see THAT ONE customer's account. Kept apart from AppUser (staff) on purpose.
/// Sign-in is by email, which always contains "@"; a staff username never does, so the two can never be the same name.
model CustomerUser {
  id             String    @id @default(cuid())
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId     String
  /// Stored lower-cased and trimmed (a CHECK enforces it), so one address is one account.
  email          String    @unique
  name           String
  /// Null until the invitation is accepted.
  passwordHash   String?
  active         Boolean   @default(true)
  /// Bumping this signs the person out everywhere.
  sessionVersion Int       @default(1)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(3)
  lastLoginAt    DateTime? @db.Timestamptz(3)
  createdBy      String
  createdById    String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  invites        PortalInvite[]

  @@index([customerId])
}

/// One-time link that lets a contact set their password. Only the hash of the token is stored. At most one is live per
/// person (a partial unique index in the migration), and a newer one revokes the older.
model PortalInvite {
  id             String       @id @default(cuid())
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  customerUserId String
  tokenHash      String       @unique
  expiresAt      DateTime     @db.Timestamptz(3)
  usedAt         DateTime?    @db.Timestamptz(3)
  revokedAt      DateTime?    @db.Timestamptz(3)
  createdBy      String
  createdById    String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([customerUserId])
}

/// Append-only. A mistake is voided (one-way marker), never edited or deleted.
model LedgerEntry {
  id          String    @id @default(cuid())
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId  String
  /// CHARGE | PAYMENT | ADJUSTMENT | WRITE_OFF | REVERSAL
  type        String
  /// Positive for CHARGE, PAYMENT and WRITE_OFF; signed for ADJUSTMENT and REVERSAL.
  amountCents Int
  entryDate   DateTime  @db.Date
  /// When a charge falls due. Null falls back to entryDate.
  dueDate     DateTime? @db.Date
  /// Invoice or check number.
  reference   String?
  note        String?
  createdBy   String
  /// The user's id. createdBy is only the name at the time; names are not unique and can change.
  createdById String?
  /// One per form submission, unique per customer: a retried request finds this entry instead of adding a second.
  requestKey  String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  voidedAt    DateTime? @db.Timestamptz(3)
  voidedBy    String?
  voidedById  String?
  voidReason  String?

  /// Only for a REVERSAL: the entry it offsets. An entry can be reversed once. The reversal is dated today, so a past
  /// month's figures never change.
  reversesEntryId String?      @unique
  reverses        LedgerEntry? @relation("Reversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy      LedgerEntry? @relation("Reversal")

  auditEvents AuditEvent[]

  @@unique([customerId, requestKey])
  @@index([customerId, entryDate])
}

/// Append-only record of who did what. Written in the same transaction as the change it describes.
model AuditEvent {
  id            String       @id @default(cuid())
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId    String
  /// e.g. customer.created, customer.updated, decision.approve, ledger.payment, ledger.void
  action        String
  summary       String
  /// Field-level before/after for edits.
  changes       Json?
  actor         String
  /// The user's id. Display names are not unique, so this is what ties an event to one person.
  actorId       String?
  /// staff | customer | system | anonymous. Null on events written before this column existed (the table is append-only,
  /// so they cannot be back-filled).
  actorKind     String?
  /// The ledger entry this event is about (a charge, payment, adjustment or void), so it can be traced exactly.
  ledgerEntry   LedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  ledgerEntryId String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([customerId, createdAt])
}
